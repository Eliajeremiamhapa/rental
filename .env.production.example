# =============================================================================
# Production environment template (Docker on a Linux server)
#
# Copy to ../.env next to docker-compose.yml — that file is read by Compose and
# must never be committed. This template is what belongs in git.
#
#   cp .env.production.example ../.env
#   php artisan key:generate --show   # paste into APP_KEY
# =============================================================================

APP_NAME="House & Room Rental System"
APP_ENV=production
APP_KEY=                     # REQUIRED: php artisan key:generate --show
APP_DEBUG=false
APP_URL=                     # REQUIRED: https://your-domain.example
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Rent due dates, expiry checks and the daily scheduler run on this timezone.
APP_TIMEZONE=Africa/Dar_es_Salaam

# --- Database: MySQL 8 (the "db" service in docker-compose.yml) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=rental_system
DB_USERNAME=rental
DB_PASSWORD=                  # REQUIRED
DB_ROOT_PASSWORD=             # REQUIRED (used only by the db healthcheck)

# --- Caching / session / queue ---
# "file" and "sync" keep the app self-contained: no cache table migration and no
# queue worker required. Do not switch QUEUE_CONNECTION to "database" without
# adding the jobs table migration and running a worker.
CACHE_STORE=file
CACHE_PREFIX=rental
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=sync

# Expire API tokens after N minutes (blank = never). Pruned daily.
SANCTUM_EXPIRATION=

# Only needed if the SPA and API are served from different origins.
# CORS_ALLOWED_ORIGINS=https://your-domain.example

# --- Africa's Talking SMS ---
# If these are unset, SMS is skipped and logged instead of sent.
AT_USERNAME=
AT_API_KEY=
AT_SENDER=RentalTZ
AT_BASE_URL=https://api.africastalking.com/version1/messaging

# --- Money and phone formatting ---
APP_CURRENCY=TZS
APP_PHONE_COUNTRY_CODE=255

# --- Receipt branding ---
# Drop logo.png / signature.png into backend/public/branding/.
RECEIPT_COMPANY_NAME=UVIMO
RECEIPT_COMPANY_SLOGAN=
RECEIPT_COMPANY_PHONE=
RECEIPT_COMPANY_ADDRESS=
RECEIPT_LOGO_PATH=branding/logo.png
RECEIPT_SIGNATURE_PATH=branding/signature.png

# --- First owner account ---
# Only used by the OwnerSeeder on first boot. Leave OWNER_PHONE empty to skip
# account creation entirely; set it once to provision the owner, then remove it.
OWNER_NAME=
OWNER_PHONE=
OWNER_EMAIL=
OWNER_PASSWORD=

# --- Entrypoint behaviour ---
APP_PORT=80
RUN_MIGRATIONS=true
RUN_SEEDER=true
RUN_SCHEDULER=true
DB_WAIT_SECONDS=60

# --- Laravel framework defaults ---
LOG_CHANNEL=stack
LOG_LEVEL=info
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
