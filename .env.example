APP_NAME="Nipangishe"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Business timezone: rent due dates, expiry checks and daily jobs all key off
# this. The scheduler in routes/console.php is pinned to it explicitly.
APP_TIMEZONE=Africa/Dar_es_Salaam

# Money and phone formatting used by receipts and SMS.
APP_CURRENCY=TZS
# Phone numbers are normalised to international format before sending.
# 255 = Tanzania (+255).
APP_PHONE_COUNTRY_CODE=255

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rental_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Everything is handled synchronously in-request (SMS, notifications, charge
# generation), so no queue worker is required. If you switch QUEUE_CONNECTION to
# "database" you must also create the jobs table and run a worker.
QUEUE_CONNECTION=sync

# File cache keeps the app self-contained; the "database" store needs a cache
# table that this project does not ship a migration for.
CACHE_STORE=file
# CACHE_PREFIX=

# Optional: expire Sanctum API tokens after N minutes (blank = never).
# Expired tokens are pruned by the scheduled sanctum:prune-expired job.
SANCTUM_EXPIRATION=

# Only needed when the SPA and API are served from different origins.
# CORS_ALLOWED_ORIGINS=https://app.example.com

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Africa's Talking SMS (use the live username/key once the account is in production)
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER=

# Receipt branding. Logo/signature accept an absolute path, a path inside
# public/, a path inside storage/app/, or a full URL. Drop the files in
# public/branding/ to have them embedded automatically.
RECEIPT_COMPANY_NAME=Nipangishe
RECEIPT_COMPANY_SLOGAN="Makazi yako, hatua moja karibu"
RECEIPT_COMPANY_PHONE=
RECEIPT_COMPANY_ADDRESS=
RECEIPT_LOGO_PATH=branding/logo.png
RECEIPT_SIGNATURE_PATH=branding/signature.png

# Initial owner account. Only used by "php artisan db:seed"; leave the phone
# blank to skip creating the account entirely.
OWNER_NAME=
OWNER_PHONE=
OWNER_EMAIL=
OWNER_PASSWORD=

# Initial system administrator account. Only used by "php artisan db:seed";
# leave the phone blank to skip. There is deliberately no public admin signup.
ADMIN_NAME=
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=
